+public class GameFileCheckerTest {
+    @Test public void validSingleEntryArchivePasses() throws Exception {
+        assertNull(GameFileChecker.inspect(writeArchive(archive("Data/INI/test.ini", 3, false))));
+    }
+
+    @Test public void directoryTooShortForEntryIsRejected() throws Exception {
+        byte[] bytes = archive("a", 1, false);
+        putBe32(bytes, 12, 24);
+        assertContains(GameFileChecker.inspect(writeArchive(bytes)), "directory table is too short");
+    }
+
+    @Test public void entryOutsideArchiveIsRejected() throws Exception {
+        byte[] bytes = archive("a", 1, false);
+        putBe32(bytes, 16, bytes.length + 10);
+        assertContains(GameFileChecker.inspect(writeArchive(bytes)), "points outside the archive");
+    }
+
+    @Test public void unterminatedPathIsRejected() throws Exception {
+        assertContains(GameFileChecker.inspect(writeArchive(archive("abc", 1, true))),
+                "invalid or unterminated path");
+    }
+
+    @Test public void pathLongerThanEngineBufferIsRejected() throws Exception {
+        StringBuilder name = new StringBuilder();
+        for (int i = 0; i < 260; i++) name.append('a');
+        assertContains(GameFileChecker.inspect(writeArchive(archive(name.toString(), 1, true))),
+                "path longer than the engine limit");
+    }
+
+    private static byte[] archive(String name, int payloadSize, boolean omitTerminator)
+            throws Exception {
+        byte[] path = name.getBytes(StandardCharsets.US_ASCII);
+        int dataStart = 16 + 8 + path.length + (omitTerminator ? 0 : 1);
+        int totalSize = dataStart + payloadSize;
+        ByteArrayOutputStream out = new ByteArrayOutputStream(totalSize);
+        out.write(new byte[] {'B', 'I', 'G', 'F'});
+        writeLe32(out, totalSize);
+        writeBe32(out, 1);
+        writeBe32(out, dataStart);
+        writeBe32(out, dataStart);
+        writeBe32(out, payloadSize);
+        out.write(path);
+        if (!omitTerminator) out.write(0);
+        for (int i = 0; i < payloadSize; i++) out.write(i);
+        return out.toByteArray();
+    }
+
+    private static File writeArchive(byte[] bytes) throws Exception {
+        File file = Files.createTempFile("generals-big-", ".big").toFile();
+        Files.write(file.toPath(), bytes);
+        return file;
+    }
+
+    private static void assertContains(String actual, String expected) {
+        assertTrue("Expected '" + expected + "' in: " + actual,
+                actual != null && actual.contains(expected));
+    }
+
+    private static void writeLe32(ByteArrayOutputStream out, int value) {
+        out.write(value & 0xff);
+        out.write((value >>> 8) & 0xff);
+        out.write((value >>> 16) & 0xff);
+        out.write((value >>> 24) & 0xff);
+    }
+
+    private static void writeBe32(ByteArrayOutputStream out, int value) {
+        out.write((value >>> 24) & 0xff);
+        out.write((value >>> 16) & 0xff);
+        out.write((value >>> 8) & 0xff);
+        out.write(value & 0xff);
+    }
+
+    private static void putBe32(byte[] bytes, int offset, int value) {
+        bytes[offset] = (byte) (value >>> 24);
+        bytes[offset + 1] = (byte) (value >>> 16);
+        bytes[offset + 2] = (byte) (value >>> 8);
+        bytes[offset + 3] = (byte) value;
+    }
+}
